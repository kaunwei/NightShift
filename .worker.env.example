# ==============================================================================
# 24-Hour Unattended AI Worker Daemon - Environment Configuration
# Put this file in the SAME directory as worker.sh (.worker.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System Configuration (macOS / Ubuntu / Linux)
# ------------------------------------------------------------------------------
# Options:
#   - "auto"   : Automatically detect via uname -s and /etc/os-release (default)
#   - "mac"    : Force macOS behavior (uses sysctl for CPUs, gtimeout/watchdog fallback)
#   - "ubuntu" : Force Linux Ubuntu behavior (uses nproc, native coreutils timeout)
#   - "linux"  : Generic Linux behavior
OS_TYPE="${OS_TYPE:-auto}"

# ------------------------------------------------------------------------------
# 2. Worker Identity & Parallelization
# ------------------------------------------------------------------------------
# Unique identifier for this worker instance (default: "default")
# When running multiple workers in parallel worktrees, set different IDs:
# e.g., "worker-1", "worker-2", etc.
WORKER_ID="${WORKER_ID:-default}"

# ------------------------------------------------------------------------------
# 3. Model & AI CLI Configuration
# ------------------------------------------------------------------------------
# Supported CLI: "agy" (Google Antigravity CLI)
AI_CLI="${AI_CLI:-agy}"

# Model Selection:
#   - Gemini: gemini-3.8-flash-low (Recommended default), gemini-3.8-flash-medium,
#             gemini-3.8-flash-high, gemini-4-argon-low, gemini-4-argon-medium
#   - Claude: claude-opus-5-5-low, claude-sonnet-5-5-low
AI_MODEL="${AI_MODEL:-gemini-3.8-flash-low}"

# Reasoning effort level: low | medium | high | xhigh | max
# (Only applied if AI_MODEL does not include an effort suffix)
AI_EFFORT="${AI_EFFORT:-low}"

# Antigravity Execution Mode:
#   - "accept-edits" : Automatically approve file edits (Recommended for unattended runs)
#   - "auto"         : Full auto approval (requires supported account tier)
#   - "plan"         : Planning only mode
AGY_MODE="${AGY_MODE:-accept-edits}"

# ------------------------------------------------------------------------------
# 4. Timeout & Polling Controls
# ------------------------------------------------------------------------------
# Maximum timeout per task in seconds (default: 1800 = 30 minutes)
TASK_TIMEOUT="${TASK_TIMEOUT:-1800}"

# Dynamic Step Budget Formula: TASK_MAX_STEPS = STEP_BASE + (TARGET_FILES * STEP_PER_FILE)
# Scales automatically with the number of target files (no cap on file count).
STEP_BASE="${STEP_BASE:-12}"
STEP_PER_FILE="${STEP_PER_FILE:-5}"

# Queue polling interval in seconds
POLL_INTERVAL="${POLL_INTERVAL:-5}"

# Exit when queue is empty (0 = run as perpetual daemon, 1 = run once and exit)
RUN_ONCE="${RUN_ONCE:-0}"

# ------------------------------------------------------------------------------
# 4.5 Workspace Isolation & Preview Staging
# ------------------------------------------------------------------------------
# Worker Isolation Mode:
#   1 = (Default) Dual-Worktree Isolation: Worker executes in .worker-tree
#       and publishes immutable preview snapshots to .preview/ on task PASS.
#       Enables safe early-access preview without collision.
#   0 = Single-Tree In-Place Mode: Worker executes directly in repository root.
#       Recommended for projects locked to fixed ports (e.g. port 22) or hardware.
WORKER_ISOLATION="${WORKER_ISOLATION:-1}"

# Enable terminal command sandbox (0 = disabled, 1 = enabled)
USE_SANDBOX="${USE_SANDBOX:-0}"

# Additional reference directories (comma-separated absolute paths)
# e.g., ADDITIONAL_DIRS="/Volumes/Vault500G/reference_project"
ADDITIONAL_DIRS="${ADDITIONAL_DIRS:-}"

# ------------------------------------------------------------------------------
# 6. Queue & Log File Paths (Relative to worker.sh directory)
# ------------------------------------------------------------------------------
TASKS_FILE="${TASKS_FILE:-tasks.txt}"
TASKS_DONE_FILE="${TASKS_DONE_FILE:-tasks.done}"
PROGRESS_FILE="${PROGRESS_FILE:-progress.log}"
PAUSE_FILE="${PAUSE_FILE:-PAUSE}"
