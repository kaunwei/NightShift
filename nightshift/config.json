{
  "version": 1,
  "acceptance": {
    "hot": "python3 nightshift/unittest_hot.py --start test",
    "cold": "python3 -m unittest discover -s test",
    "cold_every": 5,
    "timeout": 180,
    "wiring": []
  },
  "agents": {
    "codex-main": {
      "default": true,
      "worker": {
        "task_timeout_seconds": 1800,
        "research_step_budget": 100,
        "step_base": {
          "L1": 60,
          "L2": 40,
          "L3": 20
        }
      },
      "agent": {
        "adapter": "codex",
        "command": "codex",
        "args": [],
        "env": {},
        "config": {
          "model": "gpt-6-luna",
          "effort": "low",
          "approval_mode": "auto",
          "sandbox": "workspace-write",
          "ephemeral": "1"
        }
      }
    },
    "agy-backup": {
      "default": false,
      "worker": {
        "task_timeout_seconds": 1800,
        "research_step_budget": 100,
        "step_base": {
          "L1": 60,
          "L2": 40,
          "L3": 20
        }
      },
      "agent": {
        "adapter": "agy",
        "command": "agy",
        "args": [],
        "env": {},
        "config": {
          "model": "gemini-3.8-flash-low",
          "effort": "low",
          "mode": "accept-edits"
        }
      }
    }
  },
  "code_index": {
    "include": [
      "**/*"
    ],
    "exclude": [],
    "tool": [
      "nightshift/tools/**"
    ],
    "project": [
      "**/*"
    ]
  }
}
